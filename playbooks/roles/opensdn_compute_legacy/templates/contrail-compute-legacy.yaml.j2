{% if compose_version == 1 %}
version: "2.4"
{% endif %}
services:
  openstack-compute-legacy:
    image: "{{ container_registry }}/opensdn-openstack-compute-init:{{ contrail_version_tag }}"
    network_mode: "host"
    volumes:
      - /usr/bin:/opt/plugin/bin
      - {{ pythonpath.stdout }}:/opt/plugin/site-packages
